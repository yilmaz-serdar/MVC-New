@model IReadOnlyList<AnalysisJob>
@if (Model.Count > 0)
{
    <section class="panel analysis-history" aria-labelledby="history-heading">
        <h2 id="history-heading">Önceki analizler</h2>
        <p>Tamamlanan analizler, en yeniden eskiye listelenir. Tarihler Türkiye saatidir.</p>
        <div class="table-scroll"><table>
            <thead><tr><th scope="col">Analiz tarihi</th><th scope="col">Servis adı</th><th scope="col">Analiz süresi</th><th scope="col">Sonuç e-posta adresi</th><th scope="col">İşlemler</th></tr></thead>
            <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td><time datetime="@job.CreatedAt.ToString("O")">@job.CreatedAt.ToOffset(TimeSpan.FromHours(3)).ToString("dd.MM.yyyy HH:mm")</time></td>
                    <td>@job.Request.ServiceName</td><td>Son @job.Request.Days gün</td><td>@job.Request.Email</td>
                    <td><div class="history-actions">
                        <a asp-action="Analyze" asp-route-id="@job.Id">Sonuçları Gör</a>
                        <form asp-action="Analyze" method="post">
                            <input type="hidden" name="Request.ServiceName" value="@job.Request.ServiceName" />
                            <input type="hidden" name="Request.Days" value="@job.Request.Days" />
                            <input type="hidden" name="Request.Email" value="@job.Request.Email" />
                            <input type="hidden" name="force" value="true" />
                            <button type="submit">Yeniden Analiz Et</button>
                        </form>
                    </div></td>
                </tr>
            }
            </tbody>
        </table></div>
    </section>
}
