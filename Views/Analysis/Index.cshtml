@model AnalysisPageViewModel
@if (ViewData["EmailState"] as string == "Failed")
{
    <p class="error" role="alert">Analiz tamamlandı ancak e-posta gönderilemedi. Sonuçları aşağıda inceleyebilirsiniz.</p>
}

        <div class="breadcrumb">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
           
            aria-hidden="true"
          >
            <path
              d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"
            ></path>
            <path
              d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"
            ></path>
            <path
              d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"
            ></path>
          </svg>
          Çalışma alanı
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
           
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6"></path></svg
          ><span>Bağımlılık analizi</span>
        </div>
        <section class="heading">
          <div>
            <h1>Servis bağımlılık analizi<span>.</span></h1>
            <p>
              Proje bağımlılıklarını ve uçtan uca servis çağrılarını tek bir
              görünümde inceleyin.
            </p>
          </div>
          <div class="heading-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
             
              aria-hidden="true"
            >
              <rect x="16" y="16" width="6" height="6" rx="1"></rect>
              <rect x="2" y="16" width="6" height="6" rx="1"></rect>
              <rect x="9" y="2" width="6" height="6" rx="1"></rect>
              <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path>
              <path d="M12 12V8"></path>
            </svg>
          </div>
        </section>
        <section class="form-card" aria-labelledby="analysis-heading">
          <div class="form-intro">
            <span class="icon-tile"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
               
                aria-hidden="true"
              >
                <path
                  d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"
                ></path></svg
            ></span>
            <div>
              <h2 id="analysis-heading">Yeni analiz</h2>
              <p>İncelemek istediğiniz servisi ve zaman aralığını seçin.</p>
            </div>
            <span class="step">01 <span>/ ANALİZ PARAMETRELERİ</span></span>
          </div>
          <form id="analysis-form" asp-controller="Analysis" asp-action="Analyze" method="post">
            <div class="field service-field">
              <label for="service">Servis Adı <span>*</span></label>
              <div class="input-wrap">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="2" y="3" width="20" height="7" rx="2" />
                  <rect x="2" y="14" width="20" height="7" rx="2" />
                  <path d="M6 6h.01M6 17h.01" /></svg
                ><input
                  id="service"
                  class="service-input"
                  asp-for="Request.ServiceName"
                  
                  placeholder="Örn. Mobile-Banking-Service"
                  maxlength="100"
                  required
                  aria-describedby="service-hint form-error"
                />
              </div>
              <small id="service-hint"
                >Analiz edilecek servisin tam adını girin.</small
              >
            </div>
            <div class="field">
              <label for="duration">Analiz Süresi</label
              ><select id="duration" class="duration-select" asp-for="Request.Days">
                @foreach (var days in Model.DurationOptions)
{
<option value="@days">Son @days gün</option>
}
</select><small>Seçilen zaman aralığındaki çağrılar incelenir.</small>
            </div>
            <div class="field email-field">
              <label for="email">Sonuç E-posta Adresi <span>*</span></label>
              <input id="email" class="email-input" asp-for="Request.Email" type="email" maxlength="254" required placeholder="ornek@firma.com" aria-describedby="email-hint form-error" />
              <small id="email-hint">Analiz tamamlandığında sonuçlar bu adrese gönderilir.</small>
            </div>
            <button type="submit" class="analyze-button" id="analyze-button">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M2 12h4l3-9 6 18 3-9h4" /></svg
              ><span>Analiz Et</span
              ><svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </button>
          </form>
          <div id="form-error" class="error" role="alert" asp-validation-summary="All"></div>
          <div class="form-note">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
             
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path></svg
            ><span
              >@(Model.Result?.IsDemo == false ? "Analiz sonuçları sunucudan alındı." : "Eklenen örnek servis yanıtı kullanılıyor. Servis adı ve süre seçimi bu dosyanın içeriğini filtrelemez.")</span
            >
          </div>
        </section>
        
@if (Model.Result is not null)
{
    <partial name="_Results" model="Model.Result" />
}
else
{
    <section class="empty-state"><div class="empty-network" aria-hidden="true"><span>◇</span><i></i><span class="empty-main">⌘</span><i></i><span>◇</span></div><h2>Her bağlantı, daha net bir görünüm.</h2><p>Servis adını girip analizi başlatın. Proje bağımlılıkları ve servis topolojisi burada görünecek.</p><div class="empty-caption">Proje bağımlılıkları · Uçtan uca topoloji</div></section>
}
