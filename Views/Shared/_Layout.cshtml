<!doctype html>
<html lang="tr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Servis Bağımlılık Analizi | Dependency Analyzer</title><link rel="icon" href="~/favicon.svg" /><link rel="stylesheet" href="~/css/analysis.css" asp-append-version="true" /><script src="~/lib/cytoscape/cytoscape.min.js" asp-append-version="true" defer></script><script src="~/js/topology-graph.js" asp-append-version="true" defer></script><script src="~/js/topology-explorer.js" asp-append-version="true" defer></script><script src="~/js/analysis.js" asp-append-version="true" defer></script></head><body><header class="topbar">
