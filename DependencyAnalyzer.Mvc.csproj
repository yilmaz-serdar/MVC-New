<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DependencyAnalyzer.Mvc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="Data/service-topology.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="Tests/**/*.cs" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
  </ItemGroup>
</Project>
